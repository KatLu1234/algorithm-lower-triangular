# 프론트엔드 환경변수 예시 — 실제 값은 .env.local 에 복사해서 쓰세요.
# ⚠️ 비-비밀 값만 둡니다. LLM 키·Supabase 시크릿은 절대 프론트에 두지 않습니다
#    (claude/frontend/team-guide.md §4, claude/base/CLAUDE.md §7).

# 서버 API 베이스 URL.
# - 비워두면 client.ts가 같은 오리진의 "/api/v1" 을 사용하고, 개발 시에는
#   vite.config.ts 의 프록시가 http://127.0.0.1:8000 으로 넘깁니다.
# - 별도 호스트의 백엔드를 쓸 때만 채웁니다. 예: https://api.example.com
VITE_API_BASE_URL=
