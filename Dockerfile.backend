# 백엔드 — FastAPI + uvicorn
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv

# 의존성 먼저 (Docker 레이어 캐시)
COPY requirements.txt .
RUN pip install -r requirements.txt

# 앱 소스 + 정적 데이터 CSV (엔드포인트가 부팅 시 1회 로드 후 캐시)
#   - sample_data.csv: 국민대 강의 카탈로그
#   - buildings.csv + building_travel_times.csv: 캠퍼스 건물 + 직접 도보 거리
COPY app ./app
COPY sample_data.csv ./sample_data.csv
COPY buildings.csv ./buildings.csv
COPY building_travel_times.csv ./building_travel_times.csv

# LLM-A 프롬프트 (app/libs/llm_context.py가 런타임에 읽음). 영역 분리 규칙
# (architecture.md §3.3)에 따라 .md/.json 데이터 자산만 포함, 코드는 제외.
COPY claude/llm-include/prompts ./claude/llm-include/prompts

EXPOSE 8000

# 헬스체크 — nginx가 backend 컨테이너 ready 여부 확인 가능
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2)" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
